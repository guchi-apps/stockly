// Stocklyの在庫データはこのスキーマを正本とする。
//
// 前半は利用者と家庭の境界（#2）、後半は在庫のモデル（#3）。
// 在庫を持つモデルは必ず`householdId`を持ち、`src/lib/household/access.ts`の関数を
// 通してのみ読み書きする。
//
// 在庫側の設計の柱は次の3つ。変更するときはこの前提を崩していないか確かめること。
//
// 1. 在庫の実体は「ロット」(StockLot)。同一商品・同一期限・同一保管場所のかたまりを1件とし、
//    期限や保管位置が違えば別ロットになる。
// 2. 数量の増減はすべてInventoryTransactionにappend-onlyで積む。既存行のUPDATE/DELETEは
//    行わず、取消も「符号を反転した REVERSAL 行を足す」ことで表す。
//    したがってStockLot.quantityは常に「そのロットのtransactionのquantityDeltaの合計」に等しく、
//    ずれはsrc/lib/inventory/ledger.tsのverifyLotQuantity()で検出できる。
// 3. 他家庭のデータを参照できないことをDB制約で担保する。家庭に属する全モデルは
//    householdIdを持ち、@@unique([householdId, id])を置く。子から親への参照は
//    [householdId, 親Id]の複合外部キーにしてあるため、householdIdが違う行は
//    そもそも外部キーを満たせない。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Stocklyの利用者。Supabase Authのユーザーと1対1で対応する。
///
/// Supabaseは他アプリと共有のプロジェクトのため、「Supabaseで認証できること」は
/// 「Stocklyを使ってよいこと」を意味しない。利用可否は`ALLOWED_GOOGLE_EMAILS`で判定し、
/// 許可されたときだけこの行を作る（src/app/auth/callback/route.ts）。
model User {
  id String @id @default(cuid())

  /// Supabase Authのユーザーid（`auth.users.id`のUUID）。認証との唯一の接点。
  supabaseUserId String  @unique
  email          String?
  name           String?
  imageUrl       String? @db.Text

  memberships HouseholdMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 在庫を共有する単位。家族で1つの在庫を見るための器で、在庫データの所有者はここ。
model Household {
  id   String @id @default(cuid())
  name String

  members HouseholdMember[]

  // 在庫側（#3）。在庫データの所有者はHouseholdで、家庭を消せば在庫も消える。
  categories       Category[]
  products         Product[]
  productAliases   ProductAlias[]
  productRules     ProductRule[]
  barcodes         Barcode[]
  storageLocations StorageLocation[]
  storagePositions StoragePosition[]
  stockLots        StockLot[]
  transactions     InventoryTransaction[]

  // 補充とNotion買い物リスト連携（#6）。
  replenishmentRules  ReplenishmentRule[]
  shoppingListEntries ShoppingListEntry[]

  // 期限と通知（#5）。
  expirySetting          ExpirySetting?
  notificationDeliveries NotificationDelivery[]

  // 防災ストックの判定（#7）。
  disasterPlanSetting DisasterPlanSetting?

  // 防災バッグの点検（#8）。
  disasterBags            DisasterBag[]
  disasterBagInspections  DisasterBagInspection[]

  // 写真からの登録候補（#10）。
  intakeBatches     IntakeBatch[]
  intakeImages      IntakeImage[]
  intakeCandidates  IntakeCandidate[]
  intakeSetting     IntakeSetting?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 利用者が家庭に所属していることを表す。**在庫への到達可否はこの行の有無だけで決まる。**
///
/// 利用者は複数の家庭に所属しうる（自宅と実家など）ため、UserとHouseholdの多対多にしている。
model HouseholdMember {
  id String @id @default(cuid())

  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 記録した本人として入出庫履歴から参照される（#3）。
  transactions InventoryTransaction[]
  /// 写真を取り込んだ本人として参照される（#10）。
  intakeBatches IntakeBatch[]

  /// 同じ家庭に同じ利用者が二重に所属しないことをDBで保証する。
  @@unique([householdId, userId])
  /// 入出庫履歴が[householdId, memberId]の複合外部キーで参照するための一意キー。
  /// これがないと「他家庭のメンバーを記録者にした履歴」をDBで防げない。
  @@unique([householdId, id])
  @@index([userId])
}

/// 家庭内での権限。今回は所属の有無だけで境界を判定し、ここでの差はまだ付けていない。
/// 招待・共有を扱うIssueで、OWNERだけができる操作（家庭の削除・メンバーの除名）を足す。
enum HouseholdRole {
  OWNER
  MEMBER
}

// ===========================================================================
// 在庫のモデル（#3）
// ===========================================================================

/// 単位の次元。次元が違う値は換算できないため、合算してはいけない。
enum UnitDimension {
  COUNT // 個数（個・パック・本…）
  VOLUME // 容量（mL・L）
  MASS // 重量（g・kg）
  SERVING // 食数
  USE // 使用回数
}

/// 数量の単位。次元と基準単位への換算係数はsrc/lib/inventory/units.tsが持つ。
/// COUNT次元の単位どうし（個とパックなど）は商品ごとの入数が分からないと換算できないので、
/// 同じ単位どうしでしか合算できない扱いにしてある。
enum UnitCode {
  PIECE // 個
  PACK // パック
  BOTTLE // 本
  CAN // 缶
  BAG // 袋
  BOX // 箱
  ROLL // ロール
  MILLILITER
  LITER
  GRAM
  KILOGRAM
  SERVING // 食
  USE // 回
}

enum CategoryKind {
  FOOD // 食材
  DRINK // 飲料
  DAILY // 日用品
  EMERGENCY // 防災用品
  OTHER
}

/// 保管場所の種類。温度帯と合わせて防災判定（常温で置けるか）に使う。
enum StorageKind {
  REFRIGERATOR
  FREEZER
  PANTRY
  CUPBOARD
  CLOSET
  EMERGENCY_STOCK
  OTHER
}

enum TemperatureZone {
  AMBIENT // 常温
  CHILLED // 冷蔵
  FROZEN // 冷凍
}

/// 非常時にその商品が担う役割。防災判定の集計軸。
///
/// **`src/lib/disaster/rules.ts`の`DISASTER_CATEGORY_RULES`が、この値を6区分
/// （食料・飲料・衛生・照明・電源・熱源）へ割り当てる。** 値を足したら、どの区分で数えるか
/// （またはどの区分でも数えないか）をあちらにも書くこと。書き忘れた役割は防災の集計から
/// 静かに落ちる。
enum EmergencyRole {
  NONE
  STAPLE_FOOD // 主食
  SIDE_DISH // 主菜・副菜
  DRINKING_WATER // 飲料水
  UTILITY_WATER // 生活用水
  HEAT_SOURCE // 熱源（カセットボンベ等）
  SANITATION // 衛生
  LIGHTING // 照明（ライト・ランタン）
  POWER // 電源（モバイルバッテリー・乾電池）
  MEDICAL // 医療
  OTHER
}

enum ProductAliasSource {
  MANUAL
  RECEIPT
  BARCODE
  AI
}

enum BarcodeSymbology {
  JAN
  EAN13
  EAN8
  UPC_A
  CODE128
  QR
  OTHER
}

/// コードと商品の結び付きが、どうやって決まったか（#9）。
///
/// 外部の商品APIはまだ入れていないので、実際に付くのはSCANかMANUALだけ。
/// EXTERNALは、APIを入れたときに「この紐付けは人ではなくAPIが決めた」と見分けるために置いてある。
enum BarcodeSource {
  SCAN // カメラで読み取って登録した
  MANUAL // コードを手で入力して登録した
  EXTERNAL // 外部の商品APIの応答から作った
}

/// 期限の付け方。ロットは賞味期限と消費期限のどちらか一方だけを持つ。
/// src/lib/inventory/operations.tsの`ExpiryKind`と同じ並びにしてある。
enum ExpiryKind {
  NONE
  BEST_BEFORE
  USE_BY
}

enum StockLotStatus {
  ACTIVE // 在庫あり
  DEPLETED // 使い切った
  DISCARDED // 廃棄した
}

/// 入出庫の種別。数量の符号は種別では決めず、quantityDeltaの符号で表す
/// （PURCHASEは正、CONSUME/DISPOSEは負、ADJUST/REVERSALは両方ありうる）。
enum InventoryTransactionType {
  PURCHASE // 購入・補充
  CONSUME // 消費
  DISPOSE // 廃棄
  ADJUST // 訂正（棚卸での差分）
  REVERSAL // 取消（既存transactionの符号反転）
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  parentId    String?
  name        String
  kind        CategoryKind @default(OTHER)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// 親カテゴリも同じ家庭のものに限る。
  parent       Category?     @relation("CategoryTree", fields: [householdId, parentId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  children     Category[]    @relation("CategoryTree")
  products     Product[]
  productRules ProductRule[]

  replenishmentRules  ReplenishmentRule[]
  shoppingListEntries ShoppingListEntry[]

  /// 子から[householdId, id]で参照するための一意キー。以下の各モデルにも同じ狙いで置いてある。
  @@unique([householdId, id])
  /// カテゴリ名は家庭内で一意。親ごとの一意にしないのは、MySQLのUNIQUEがNULLを重複扱いしないため、
  /// parentIdがNULLのトップレベルで名前の重複を防げないから。
  @@unique([householdId, name])
  @@index([householdId, parentId])
}

/// 商品マスタ。在庫そのものではなく「何であるか」を持つ。
model Product {
  id          String  @id @default(cuid())
  householdId String
  categoryId  String?
  name        String
  /// ブランド・メーカー。未指定は空文字にする（NULLだと@@uniqueが効かないため）。
  brand       String  @default("")
  note        String? @db.Text

  /// 在庫数量の既定の単位。ロットごとに別の単位を使うこともできる。
  defaultUnit     UnitCode  @default(PIECE)
  /// 1defaultUnitあたりの内容量（例: 1本 = 500 MILLILITER）。容量での集計に使う。
  contentAmount   Decimal?  @db.Decimal(14, 3)
  contentUnit     UnitCode?
  /// 1defaultUnitあたりの食数・使用回数。防災の「何日分あるか」の集計に使う。
  servingsPerUnit Decimal?  @db.Decimal(14, 3)
  usesPerUnit     Decimal?  @db.Decimal(14, 3)

  // --- 防災判定用の属性 ---
  /// 保管に必要な温度帯。AMBIENTなら停電時も置いておける。
  temperatureZone    TemperatureZone @default(AMBIENT)
  /// 食べる・使うのに加熱が要るか。
  requiresHeating    Boolean         @default(false)
  /// 食べる・使うのに水が要るか（アルファ米など）。
  requiresWater      Boolean         @default(false)
  /// 非常時に担う役割。
  emergencyRole      EmergencyRole   @default(NONE)
  /// 上の固定列で表せない防災判定用の属性を足すための逃がし先。
  /// 判定に恒常的に使う属性は、ここではなく列として切り出すこと。
  disasterAttributes Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household    Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category     Category?              @relation(fields: [householdId, categoryId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  aliases      ProductAlias[]
  barcodes     Barcode[]
  /// バーコードから呼び出す候補の最優先の材料（#9）。商品1つにつき0件か1件。
  rule         ProductRule?
  stockLots    StockLot[]
  transactions InventoryTransaction[]

  replenishmentRules  ReplenishmentRule[]
  shoppingListEntries ShoppingListEntry[]

  @@unique([householdId, id])
  @@unique([householdId, name, brand])
  @@index([householdId, categoryId])
  @@index([householdId, emergencyRole])
}

/// レシート読み取り・バーコード照会・AI候補が返した表記ゆれを商品に寄せるための別名。
model ProductAlias {
  id          String             @id @default(cuid())
  householdId String
  productId   String
  alias       String
  source      ProductAliasSource @default(MANUAL)
  /// 自動生成した候補の確からしさ（0〜1）。手入力はnull。
  confidence  Decimal?           @db.Decimal(4, 3)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [householdId, productId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([householdId, id])
  /// 同じ別名が複数の商品を指すと解決できないので、家庭内で一意にする。
  @@unique([householdId, alias])
  @@index([householdId, productId])
}

/// バーコードと商品の紐付け（#9）。
///
/// **1つのコードは家庭内で1商品にしか紐付かない**（`@@unique([householdId, code])`）。
/// 読み取ったコードから商品が一意に決まらないと候補を出せないため、重複は作らせず、
/// 間違っていた場合は「付け替え」でこの行のproductIdを差し替える。
model Barcode {
  id          String           @id @default(cuid())
  householdId String
  productId   String
  code        String
  symbology   BarcodeSymbology @default(JAN)

  /// この紐付けをどうやって決めたか。
  source     BarcodeSource @default(MANUAL)
  /// 外部の商品APIから作った場合の出典名（例: `openbd`）。使っていなければ空文字。
  sourceName String        @default("")
  /// 外部APIの応答をそのまま残したもの。同じコードを二度問い合わせないためのキャッシュで、
  /// 中身の形は出典ごとに違う。**アプリの判断はここを読まずに、上の列と商品マスタで行う**
  /// （出典ごとの形に依存すると、出典を替えたときに壊れる）。
  sourcePayload Json?
  /// `sourcePayload`を取得した時刻。キャッシュの鮮度の判定に使う。
  fetchedAt     DateTime?

  /// このコードで在庫を登録した回数と、最後に登録した時刻。
  useCount   Int       @default(0)
  lastUsedAt DateTime?
  /// 読み取ったのに別の商品として登録された回数。誤紐付けの疑いとして一覧の先頭に出す。
  /// 付け替えるか「そのままにする」を選んだ時点で0へ戻す。
  mismatchCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [householdId, productId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([householdId, id])
  @@unique([householdId, code])
  @@index([householdId, productId])
}

/// 商品ごとの「前回ユーザーが確定した内容」＝学習ルール（#9）。
///
/// バーコードから出す候補の優先順位は **確定済みルール > バーコードマスタ > AI候補** で、
/// これはその最上位。在庫を登録・編集して確定するたびに上書きするので、
/// AIや外部APIが何を返しても、その家庭で最後に人が決めた値が勝つ。
///
/// **商品1つにつき1行**（`@@unique([householdId, productId])`）。履歴として複数世代を残さないのは、
/// 使うのが常に最新の1件だからで、いつ何を確定したかは`InventoryTransaction`と`StockLot`に残る。
model ProductRule {
  id          String @id @default(cuid())
  householdId String
  productId   String

  categoryId        String?
  unit              UnitCode?
  storageLocationId String?
  storagePositionId String?

  expiryKind ExpiryKind @default(NONE)
  /// 登録日から期限までの日数。前回の入力から求め、次回は「今日＋この日数」を既定の日付にする。
  /// 日付そのものを覚えると、次に買ったときには必ず過ぎている。
  shelfLifeDays Int?

  /// 確定した回数と最後の時刻。候補の説明（「3回登録しています」）に使う。
  confirmedCount Int      @default(0)
  confirmedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [householdId, productId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  category        Category?        @relation(fields: [householdId, categoryId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  storageLocation StorageLocation? @relation(fields: [householdId, storageLocationId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  /// 詳細位置は「同じ家庭の、指定した保管場所の配下」に限る（StockLotと同じ形）。
  storagePosition StoragePosition? @relation(fields: [householdId, storageLocationId, storagePositionId], references: [householdId, storageLocationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([householdId, id])
  @@unique([householdId, productId])
  @@index([householdId, categoryId])
  @@index([householdId, storageLocationId])
  @@index([householdId, storagePositionId])
}

model StorageLocation {
  id              String          @id @default(cuid())
  householdId     String
  name            String
  kind            StorageKind     @default(OTHER)
  temperatureZone TemperatureZone @default(AMBIENT)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  household    Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  positions    StoragePosition[]
  stockLots    StockLot[]
  productRules ProductRule[]
  /// 写真から作った登録候補が置き場所として参照する（#10）。
  intakeCandidates IntakeCandidate[]
  /// 防災バッグとして点検するときの基準（#8）。種別がEMERGENCY_STOCKの保管場所だけが持つ。
  disasterBag  DisasterBag?

  @@unique([householdId, id])
  @@unique([householdId, name])
}

/// 保管場所の中の詳細位置（冷蔵庫の「上段」「ドアポケット」など）。
model StoragePosition {
  id                String   @id @default(cuid())
  householdId       String
  storageLocationId String
  name              String
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  household       Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation @relation(fields: [householdId, storageLocationId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  stockLots       StockLot[]
  productRules    ProductRule[]
  /// 写真から作った登録候補が詳細位置として参照する（#10）。
  intakeCandidates IntakeCandidate[]

  @@unique([householdId, id])
  @@unique([householdId, storageLocationId, name])
  /// StockLotが「保管場所と詳細位置の組み合わせ」で参照するための複合キー。
  /// これによりStockLotは、指定した保管場所の配下にない詳細位置を参照できない。
  @@unique([householdId, storageLocationId, id])
  @@index([householdId, storageLocationId])
}

/// 在庫の実体。同一商品・同一期限・同一保管場所のかたまりを1件とする。
model StockLot {
  id                String  @id @default(cuid())
  householdId       String
  productId         String
  storageLocationId String?
  storagePositionId String?

  /// 現在数量。transactionsのquantityDeltaの合計と常に一致する集計値で、
  /// 正本は履歴のほう。ずれの検出はverifyLotQuantity()で行う。
  quantity Decimal  @default(0) @db.Decimal(14, 3)
  unit     UnitCode

  /// 賞味期限（品質が保たれる期限）。
  bestBeforeDate DateTime? @db.Date
  /// 消費期限（安全に食べられる期限）。
  useByDate      DateTime? @db.Date
  /// 「この在庫に期限は無い」と利用者が明示したか（塩・日用品・工具など）。
  /// 期限の列が空でも、**入れ忘れ（要確認）とは区別する**。既定はfalse＝まだ確かめていない。
  noExpiry       Boolean   @default(false)
  /// 開封日時。開封後の期限計算に使う。
  openedAt       DateTime?
  acquiredAt     DateTime?

  status StockLotStatus @default(ACTIVE)
  note   String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household       Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product         Product                @relation(fields: [householdId, productId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  storageLocation StorageLocation?       @relation(fields: [householdId, storageLocationId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  /// 詳細位置は「同じ家庭の、指定した保管場所の配下」に限る。
  storagePosition StoragePosition?       @relation(fields: [householdId, storageLocationId, storagePositionId], references: [householdId, storageLocationId, id], onDelete: Restrict, onUpdate: Restrict)
  transactions    InventoryTransaction[]

  @@unique([householdId, id])
  @@index([householdId, productId, status])
  @@index([householdId, storageLocationId])
  @@index([householdId, storagePositionId])
  @@index([householdId, status, bestBeforeDate])
  @@index([householdId, status, useByDate])
}

/// 入出庫履歴。append-onlyで、既存行のUPDATE/DELETEは行わない。
/// 取消はreversesTransactionIdを持つREVERSAL行を足して表すため、
/// 現在数量は常に「quantityDeltaの単純合計」で復元できる。
model InventoryTransaction {
  id          String                   @id @default(cuid())
  householdId String
  stockLotId  String
  /// stockLot.productIdと同じ値。商品軸の集計をロットをまたいで引くために持つ。
  productId   String
  /// 記録した人（HouseholdMember）。システムが入れた行はnull。
  memberId    String?
  type        InventoryTransactionType

  /// 符号付きの増減量。正が入庫、負が出庫。
  quantityDelta Decimal  @db.Decimal(14, 3)
  /// quantityDeltaの単位。ロットの単位と換算できない単位は入れてはいけない。
  unit          UnitCode

  /// 取消対象のtransaction。REVERSAL行だけが値を持つ。
  reversesTransactionId String?

  /// 実際に購入・消費した時刻。過去に遡って記録できるようrecordedAtと分ける。
  occurredAt DateTime
  recordedAt DateTime @default(now())
  note       String?  @db.Text

  household  Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  stockLot   StockLot              @relation(fields: [householdId, stockLotId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  product    Product               @relation(fields: [householdId, productId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  member     HouseholdMember?      @relation(fields: [householdId, memberId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  reverses   InventoryTransaction? @relation("TransactionReversal", fields: [householdId, reversesTransactionId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy InventoryTransaction? @relation("TransactionReversal")

  @@unique([householdId, id])
  /// 1件のtransactionを二重に取り消せないようにする。
  @@unique([householdId, reversesTransactionId])
  @@index([householdId, stockLotId, occurredAt])
  @@index([householdId, productId, occurredAt])
  @@index([householdId, occurredAt])
  @@index([householdId, memberId])
}

// ===========================================================================
// 補充とNotion買い物リスト連携（#6）
// ===========================================================================

/// 補充候補をNotionへ送った記録の状態。
enum ShoppingListEntryStatus {
  PENDING // 候補として確定したが、まだNotionへ送っていない
  SENDING // Notionへ送信中（同じ候補の二重送信をここで止める）
  SENT // Notionの項目を作った・更新した
  FAILED // 送信に失敗した。理由をlastErrorに残し、そのまま送り直せる
}

/// 「これ以下になったら、ここまで買い足す」という補充の基準。
///
/// 対象は**商品またはカテゴリのどちらか一方**。カテゴリの基準は、そのカテゴリに属する
/// 商品の在庫を判定単位へ換算して合計し、まとめて1件の候補にする。
model ReplenishmentRule {
  id          String  @id @default(cuid())
  householdId String
  /// 商品ごとの基準。categoryIdとはどちらか一方だけを持つ（service.tsが担保する）。
  productId   String?
  /// カテゴリごとの基準。
  categoryId  String?

  /// この数量以下になったら補充候補にする。0（「なくなったら買う」）も許す。
  thresholdAmount Decimal  @db.Decimal(14, 3)
  /// 補充後にありたい数量。不足量は「targetAmount − 現在数量」で出す。
  targetAmount    Decimal  @db.Decimal(14, 3)
  /// 判定に使う単位。**この単位へ換算できない在庫は数えない**（個とパックのように
  /// 商品ごとの入数が分からないと換算できない組み合わせがあるため。src/lib/inventory/units.ts）。
  unit            UnitCode
  /// 一時的に候補から外すためのスイッチ。基準そのものは残る。
  enabled         Boolean  @default(true)
  note            String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [householdId, productId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  category  Category? @relation(fields: [householdId, categoryId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([householdId, id])
  /// 同じ対象に基準を二重に作らない。**MySQLのUNIQUEはNULLを重複扱いしない**ため、
  /// 商品の基準（categoryIdがNULL）とカテゴリの基準（productIdがNULL）を
  /// 1つのテーブルに置いても互いを縛らない。
  @@unique([householdId, productId])
  @@unique([householdId, categoryId])
  @@index([householdId, enabled])
}

/// Notionの買い物リストへ送った（または送ろうとしている）補充候補。
///
/// **買い物リストの正本はNotionで、この行はStocklyからの送信記録**。Notion側での完了・編集は
/// 読み戻さず、在庫へは一切反映しない（#6の受入条件）。項目を作り直したいときは、
/// この行を消す（画面の「取り下げる」）と、次の送信で新しいNotion項目が作られる。
model ShoppingListEntry {
  id          String  @id @default(cuid())
  householdId String
  /// 送る対象。ReplenishmentRuleと同じく、商品またはカテゴリのどちらか一方を持つ。
  productId   String?
  categoryId  String?

  /// 送った時点の表示名。商品名が後から変わっても、Notionへ何を送ったかを追える。
  name           String
  /// 送った不足量と、その単位。
  shortageAmount Decimal  @db.Decimal(14, 3)
  unit           UnitCode

  status ShoppingListEntryStatus @default(PENDING)

  /// Notion側のページid。**2回目以降はこのページを更新するので、項目が重複しない**
  /// （受入条件のidempotency/対応ID）。Notionで手動削除された場合だけ、作り直して付け替える。
  notionPageId String?
  notionUrl    String? @db.Text

  /// 最後に失敗した理由。画面に出して、そのまま送り直せるようにする。
  /// **接続に失敗しても行は残す**（在庫は元から変えていないので、戻すものは無い）。
  lastError String? @db.Text

  /// 送信を始めた時刻。SENDINGのまま取り残された行を、一定時間後に送り直せるようにする。
  sendingStartedAt DateTime?
  lastSentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [householdId, productId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  category  Category? @relation(fields: [householdId, categoryId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([householdId, id])
  /// 同じ対象の送信記録は1件だけ。ここが「同じ候補を送り直しても増えない」ことの土台で、
  /// 2回目の送信は既存の行（＝既存のNotionページ）を更新する。
  @@unique([householdId, productId])
  @@unique([householdId, categoryId])
  @@index([householdId, status])
}

// ===========================================================================
// 期限と通知（#5）
// ===========================================================================

/// 通知の種別。いまは期限だけだが、補充（#6）など別の理由の通知もここへ足す。
enum NotificationKind {
  EXPIRY // 期限切れ・期限間近
}

/// 通知先。**新しい送り先を足すときは、ここと`src/lib/notifications/channels.ts`の両方へ足す。**
/// メール・LINE等の外部サービスは、導入の可否をユーザーに確認してから追加する。
enum NotificationChannel {
  IN_APP // アプリ内のお知らせ（この行そのものが本体）
  LOG // サーバーログ
}

enum NotificationStatus {
  SENT // 送信済み
  FAILED // 送信を試みて失敗した
}

/// 家庭ごとの期限の見かた（#5）。無い家庭は`DEFAULT_EXPIRY_POLICY`と同じ既定値で動く。
model ExpirySetting {
  id          String @id @default(cuid())
  householdId String @unique

  /// 賞味期限を「期限間近」とみなす残り日数。
  bestBeforeSoonDays Int @default(7)
  /// 消費期限を「期限間近」とみなす残り日数。切れたら食べないため、賞味期限より短くしてある。
  useBySoonDays      Int @default(3)

  /// 期限が未入力の在庫を「要確認」として先頭に出すか。**期限内とはみなさない。**
  highlightUnknownExpiry Boolean @default(true)
  /// 期限の通知を送るか。
  notifyEnabled          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, id])
}

/// 送った通知の記録。**重複通知を防ぐ台帳そのもの**で、アプリ内のお知らせの実体でもある。
///
/// 同じ内容を二度送らないことは`@@unique([householdId, channel, dedupeKey])`が担保する。
/// 2回目以降は行を足さず、既存の行の`suppressedCount`を増やす（送らなかったことも記録に残す）。
/// dedupeKeyの組み立ては`src/lib/notifications/expiry-message.ts`が持つ。
model NotificationDelivery {
  id          String              @id @default(cuid())
  householdId String
  kind        NotificationKind    @default(EXPIRY)
  channel     NotificationChannel

  /// 同じ通知かどうかの判定キー。期限では「対象ロットとその状態の組み合わせ」から作るため、
  /// 状況が変わらないかぎり何度実行しても増えない。
  dedupeKey String @db.VarChar(120)

  title   String
  body    String @db.Text
  /// 通知の対象（ロットidと状態）。あとから「何を根拠に送ったか」を追えるようにする。
  payload Json?

  status NotificationStatus @default(SENT)
  error  String?            @db.Text

  /// 同じ内容で送信を見送った回数と、その最後の時刻。重複防止が効いていることの記録。
  suppressedCount  Int       @default(0)
  lastSuppressedAt DateTime?

  sentAt DateTime  @default(now())
  readAt DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, id])
  @@unique([householdId, channel, dedupeKey])
  @@index([householdId, kind, sentAt])
}

// ===========================================================================
// 防災ストックの判定（#7）
// ===========================================================================

/// 家庭ごとの防災の基準（#7）。無い家庭は`DEFAULT_DISASTER_PLAN`と同じ既定値で動くため、
/// 家庭を作るたびに行を用意しなくてよい（`ExpirySetting`と同じ考え方）。
///
/// **判定そのものはこのテーブルに保存しない。** 在庫が動けば結果は変わるので、残した行は
/// すぐ古くなる。「後から判定結果を再説明できる」ことは、
/// 「ルール版・基準・根拠ロット・除外理由を画面に出す」＋「同じ入力なら必ず同じ結果になる」
/// （`src/lib/disaster/assess.ts`は純関数で、乱数も現在時刻の暗黙参照も持たない）で満たす。
model DisasterPlanSetting {
  id          String @id @default(cuid())
  householdId String @unique

  /// 何人ぶんを、何日ぶん備えるか。必要量はこの2つに1人1日あたりの量を掛けて出す。
  peopleCount Int @default(2)
  targetDays  Int @default(3)

  // --- 1人1日あたりの必要量 ---
  /// 飲料水（L / 人日）。飲用と調理をあわせた一般的な目安が3L。
  waterLitersPerPersonDay    Decimal @default(3) @db.Decimal(14, 3)
  /// 食事（食 / 人日）。1食は商品の`servingsPerUnit`で数える。
  foodServingsPerPersonDay   Decimal @default(3) @db.Decimal(14, 3)
  /// 携帯トイレ（回 / 人日）。衛生の必要量として数える。
  sanitationUsesPerPersonDay Decimal @default(5) @db.Decimal(14, 3)

  // --- 人日ではない基準 ---
  /// 照明（個 / 人）。使うほど減るものではないので日数では増やさない。
  lightingUnitsPerPerson Decimal @default(1) @db.Decimal(14, 3)
  /// 電源（個 / 人）。同上。
  powerUnitsPerPerson    Decimal @default(1) @db.Decimal(14, 3)
  /// 熱源（回 / 日）。家族で1つの火を使う想定なので人数では増やさない。
  heatSourceUsesPerDay   Decimal @default(1) @db.Decimal(14, 3)

  // --- 何を数えるか ---
  /// 冷蔵・冷凍の在庫を防災の日数に含めるか。**停電で使えなくなる前提なので既定はfalse。**
  /// 受入条件の「明示設定なしに例外化しない」がこの2列。
  includeChilled              Boolean @default(false)
  includeFrozen               Boolean @default(false)
  /// 開封済み（飲みかけ・使いかけ）を数えるか。残量と衛生状態が分からないため既定はfalse。
  includeOpened               Boolean @default(false)
  /// 加熱が要る食料を、熱源の在庫があるときだけ数えるか。
  requireHeatSourceForHeating Boolean @default(true)
  /// 水が要る食料を、飲料水の在庫があるときだけ数えるか。
  requireWaterForRehydration  Boolean @default(true)

  /// 保存した時点の判定ルールの版（`DISASTER_RULE_VERSION`）。
  /// 判定結果と一緒に画面へ出し、あとから「どの規則で出した数字か」を辿れるようにする。
  ruleVersion String @default("v1") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, id])
}

/// 防災バッグの点検の基準（#8）。
///
/// **バッグの実体は`StorageLocation`（種別`EMERGENCY_STOCK`）で、ここはそこに
/// 「点検の単位として見るときの目標」を足すだけの拡張。** 防災用の別在庫は作らない
/// （日常の在庫から集計するというアプリの前提を崩さないため）。
///
/// 行が無いバッグは`DEFAULT_DISASTER_BAG_PLAN`（`src/lib/disaster/bag.ts`）で動く。
/// **スキーマの`@default`とコードの既定値は別々に書いてあるので、片方だけ変えないこと**
/// （`DisasterPlanSetting`と同じ約束）。
model DisasterBag {
  id                String @id @default(cuid())
  householdId       String
  /// このバッグにあたる保管場所。1つの保管場所につき1行だけ持つ。
  storageLocationId String

  /// このバッグ1つで何人・何日ぶんを目指すか。
  ///
  /// **家庭全体の基準（`DisasterPlanSetting`）とは別に持つ。** 持ち出し袋に家全体の
  /// 3日ぶんを求めるとどのバッグも常に不足になり、点検の役に立たない。
  peopleCount Int @default(1)
  targetDays  Int @default(1)

  /// 何日ごとに点検するか。最後の点検日にこれを足したものが次回の予定になる。
  inspectionIntervalDays Int @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household       Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation         @relation(fields: [householdId, storageLocationId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  inspections     DisasterBagInspection[]

  @@unique([householdId, id])
  /// 1つの保管場所につき1行。2行目を作らせない。
  @@unique([householdId, storageLocationId])
}

/// 防災バッグを点検した記録（#8）。
///
/// **ここに残すのは「そのとき人が見た結果」で、充足の判定結果そのものは保存しない**
/// （在庫が動けば変わるため。#7の方針と同じ）。件数だけは点検時点の状態として残す——
/// 後から「前回はいくつ手当てが要ったか」を振り返れるようにするため、再計算では出せない。
model DisasterBagInspection {
  id            String @id @default(cuid())
  householdId   String
  disasterBagId String

  /// 点検した日（日本時間の日付）。時刻は持たない。
  inspectedOn DateTime @db.Date
  note        String?  @db.VarChar(500)

  /// 点検した時点の中身の件数と、手当てが要ったものの件数。
  itemCount          Int @default(0)
  expiredCount       Int @default(0)
  expiringSoonCount  Int @default(0)
  unknownExpiryCount Int @default(0)

  /// 記録した時点の判定ルールの版（`DISASTER_RULE_VERSION`）。
  ruleVersion String @db.VarChar(20)

  createdAt DateTime @default(now())

  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  disasterBag DisasterBag @relation(fields: [householdId, disasterBagId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([householdId, id])
  @@index([householdId, disasterBagId, inspectedOn])
}

// ===========================================================================
// 写真からの登録候補（#10）
// ===========================================================================

/// 撮った写真の種類。プロンプトの組み立てと、抽出結果の読み方をこれで分ける。
enum IntakeImageKind {
  RECEIPT // レシート
  PURCHASE // 買ってきた品物をまとめて撮ったもの
  EXPIRY_LABEL // 期限の印字だけを撮ったもの
  UNKNOWN // 種類を選ばなかった（モデルに判断させる）
}

/// 取り込み1回の状態。
enum IntakeBatchStatus {
  EXTRACTING // モデルへ送っている最中
  REVIEWING // 抽出できた。人の確認待ち
  APPLIED // 確認待ちの候補が残っていない
  FAILED // 抽出に失敗した。手入力へ戻す
  DISCARDED // 人が破棄した
}

/// 候補1件の状態。
enum IntakeCandidateStatus {
  PENDING // 確認待ち
  APPLIED // 在庫へ反映した
  REJECTED // 却下した（レジ袋・値引き行など、在庫にしないもの）
}

/// 候補の期限の種別。
///
/// **`src/lib/inventory/operations.ts`の`EXPIRY_KINDS`と同じ並びにしてある。**
/// 在庫側の`ExpiryKind`と分けているのは、候補には「読めなかった＝UNKNOWN」があるため
/// （在庫側の`ExpiryKind`に`UNKNOWN`を足すと、`ProductRule`の意味まで変わる）。
enum IntakeExpiryKind {
  UNKNOWN
  NONE
  BEST_BEFORE
  USE_BY
}

/// 写真を1回取り込んだ記録（#10）。
///
/// **判定（候補の中身）はここに保存するが、在庫そのものはまだ動かさない。** 人が確認・修正して
/// 「反映する」を押したときに、はじめて`src/lib/inventory/service.ts`の`createStockLot()`が動く。
///
/// 使ったモデル・プロンプトの版・トークン数を残すのは、あとから「どの条件で出した候補か」を
/// 説明できるようにするため（#7のルール版と同じ考え方）。**候補の再抽出はしない**——
/// モデルの応答は同じ入力でも揺れるので、残した候補のほうを正とする。
model IntakeBatch {
  id          String @id @default(cuid())
  householdId String
  /// 取り込んだ人（HouseholdMember）。システムが入れた行はnull。
  memberId    String?

  status IntakeBatchStatus @default(EXTRACTING)

  /// 実際に使ったモデルidとプロンプトの版。設定を変えても、この行が指す条件は変わらない。
  model         String @db.VarChar(60)
  promptVersion String @db.VarChar(20)

  /// 送受信したトークン数と、そこから出した概算の金額（円）。
  /// **請求の正はAnthropic側の明細**で、ここは費用上限の歯止めに使う目安。
  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  estimatedCostYen Decimal @default(0) @db.Decimal(10, 3)

  /// 失敗した理由。画面に出して、手入力へ戻す案内と一緒に見せる。
  error String? @db.Text

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household  Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member     HouseholdMember?  @relation(fields: [householdId, memberId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  images     IntakeImage[]
  candidates IntakeCandidate[]

  @@unique([householdId, id])
  @@index([householdId, status, createdAt])
  /// 今月の使用量（回数・概算金額）は、この索引でこのテーブルを数えて出す。
  /// 使用量の専用テーブルは持たない（集計で出せるものを別に保存すると必ずずれる）。
  @@index([householdId, createdAt])
  @@index([householdId, memberId])
}

/// 取り込んだ画像1枚。
///
/// **同じ画像を送り直しても2件目を作らない**（`@@unique([householdId, sha256])`）。これが
/// 受入条件の「同じレシート/画像の再送による二重登録を防ぐ」の土台で、2回目のアップロードは
/// 新しい取り込みを作らず、前回の取り込みへ案内する。
///
/// 画像そのもの（`data`）は保存期間を過ぎたら消すが、**`sha256`は消さない**——
/// ハッシュを消すと、画像を消した瞬間に二重登録の防止が効かなくなる。
model IntakeImage {
  id          String @id @default(cuid())
  householdId String
  batchId     String

  kind IntakeImageKind @default(UNKNOWN)

  /// 送った画像そのもののSHA-256（16進64文字）。
  sha256   String @db.Char(64)
  mimeType String @db.VarChar(60)
  byteSize Int
  width    Int?
  height   Int?

  /// 画像の中身。**保存期間を過ぎるか、利用者が消すとnullになる**（行そのものは残す）。
  /// 「保存しない」設定の家庭では、抽出が終わった時点でnullにする。
  data Bytes? @db.LongBlob
  /// この時刻を過ぎたら`data`を消す。「保存しない」設定ではnull。
  retainUntil DateTime?
  /// `data`を実際に消した時刻。画面で「削除済み」と出すために持つ。
  purgedAt    DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household  Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  batch      IntakeBatch       @relation(fields: [householdId, batchId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  candidates IntakeCandidate[]

  @@unique([householdId, id])
  /// 二重登録の防止。家庭内で同じ画像は1枚だけ持つ。
  @@unique([householdId, sha256])
  @@index([householdId, batchId, sortOrder])
  /// 保存期間切れの掃除がこの索引で走る。
  @@index([householdId, retainUntil])
}

/// 写真から作った「在庫の登録候補」1件。
///
/// **列は`StockLotFormValue`（`src/lib/inventory/operations.ts`）にそのまま渡せる形に揃えてある。**
/// 反映は候補ごとに`createStockLot()`を呼ぶだけで、写真専用の在庫の作り方は持たない。
///
/// **二重反映の防止に専用の列を持たない。** 反映のとき、この行の`id`をそのまま
/// `InventoryTransaction.id`（＝`operationId`）に使う。2回目は主キーの重複になるので、
/// 数量を動かさず`duplicate`として返る（在庫の二重送信対策と同じ方式）。
///
/// **読めなかった欄はnullのままにする。** 0や空文字で埋めると「読めなかった」と
/// 「そう読めた」の区別が消え、受入条件の「読めなかった項目を表示する」を満たせない。
model IntakeCandidate {
  id          String @id @default(cuid())
  householdId String
  batchId     String
  /// どの画像から作った候補か。画像を消しても候補は残るのでnullableではなく参照を保つ。
  imageId     String?

  status IntakeCandidateStatus @default(PENDING)

  // --- 登録の内容（読めなかった欄はnull / 空文字） ---
  productName  String  @default("") @db.VarChar(120)
  brand        String  @default("") @db.VarChar(120)
  categoryName String  @default("") @db.VarChar(120)
  amount       Decimal? @db.Decimal(14, 3)
  unit         UnitCode @default(PIECE)

  /// 保管場所は名前ではなくidで持つ。抽出のときに
  /// 「確定済みルール → 写真から読んだ場所名が既存の保管場所と一致」の順で解決し、
  /// 決まらなければ未設定にする（**保管場所を勝手に作らない**）。
  storageLocationId String?
  storagePositionId String?

  expiryKind IntakeExpiryKind @default(UNKNOWN)
  expiryDate DateTime?        @db.Date
  opened     Boolean          @default(false)
  note       String?          @db.Text

  // --- 候補の説明（受入条件の「信頼度・根拠・読めなかった項目」） ---
  /// 候補全体の確からしさ（0〜1）。
  confidence             Decimal? @db.Decimal(4, 3)
  /// 欄ごとの確からしさ（0〜1）。**画面に常に出すので列として切り出してある。**
  productNameConfidence  Decimal? @db.Decimal(4, 3)
  amountConfidence       Decimal? @db.Decimal(4, 3)
  expiryConfidence       Decimal? @db.Decimal(4, 3)
  categoryConfidence     Decimal? @db.Decimal(4, 3)
  storageConfidence      Decimal? @db.Decimal(4, 3)

  /// 抽出の根拠。写真のどこをどう読んだか（レシートの行そのものなど）を人の言葉で残す。
  evidence String? @db.VarChar(500)
  /// 欄ごとの出所（`src/lib/barcode/candidate.ts`の`CandidateSources`をそのまま入れる）。
  /// 判定には使わず、画面のチップにだけ使う表示用のメタデータなのでJsonでよい。
  fieldSources Json?

  /// 反映してできた在庫ロット。反映済みの候補から在庫へ飛べるようにする。
  appliedStockLotId String?
  appliedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  batch           IntakeBatch      @relation(fields: [householdId, batchId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  image           IntakeImage?     @relation(fields: [householdId, imageId], references: [householdId, id], onDelete: Cascade, onUpdate: Cascade)
  /// **`SetNull`にはできない。** 複合外部キーの先頭が`householdId`（NOT NULL）なので、
  /// MySQLはNULLを入れられずエラーになる。`StockLot`・`ProductRule`と同じ`Restrict`にし、
  /// 保管場所を消すときは`service.ts`が先に参照を外す。
  storageLocation StorageLocation? @relation(fields: [householdId, storageLocationId], references: [householdId, id], onDelete: Restrict, onUpdate: Restrict)
  /// 詳細位置は「同じ家庭の、指定した保管場所の配下」に限る（StockLotと同じ形）。
  storagePosition StoragePosition? @relation(fields: [householdId, storageLocationId, storagePositionId], references: [householdId, storageLocationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([householdId, id])
  @@index([householdId, batchId, status])
  @@index([householdId, imageId])
  @@index([householdId, storageLocationId])
  @@index([householdId, storagePositionId])
}

/// 家庭ごとの写真取込の設定（#10）。
///
/// 行が無い家庭は`DEFAULT_INTAKE_SETTINGS`（`src/lib/intake/settings.ts`）で動く。
/// **スキーマの`@default`とコードの既定値は別々に書いてあるので、片方だけ変えないこと**
/// （`ExpirySetting`・`DisasterPlanSetting`と同じ約束）。
model IntakeSetting {
  id          String @id @default(cuid())
  householdId String @unique

  /// 画像を何日保存するか。**0は「保存しない」**（抽出が終わった時点で中身を消す）。
  imageRetentionDays Int @default(30)

  /// 登録済みの商品名の一覧をモデルへ一緒に送るか。表記ゆれを既存商品へ寄せやすくなるが、
  /// 家庭の持ち物がモデルへ渡るため**既定はオフ**（明示設定なしに送る範囲を広げない）。
  sendProductNames Boolean @default(false)

  /// 月あたりの上限。0は「上限なし」。
  monthlyRequestLimit Int     @default(100)
  monthlyCostLimitYen Decimal @default(1000) @db.Decimal(10, 2)
  /// 上限に達したら抽出を止めるか。止まっている間も手入力での登録は使える。
  stopOnLimit         Boolean @default(true)

  /// 使うモデルid。空なら環境変数の既定（`STOCKLY_AI_MODEL`）を使う。
  model String @default("") @db.VarChar(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, id])
}
