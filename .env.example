# アプリ実行時に参照する環境変数の一覧。値は書かない（実値は1Passwordとローカルの.env.localにのみ置く）。
# ローカル開発の記入例は .env.local.example を参照する。

# MariaDBへの接続URL。本番では下のDB_*から scripts/construct-database-url.sh が組み立てる
DATABASE_URL=

# Supabase Auth（他アプリと共有のSupabaseプロジェクト）。organizationの共通値を使う
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 利用を許可するGoogleアカウント（カンマ区切り）。未設定の場合は誰もログインできない（fail-closed）
ALLOWED_GOOGLE_EMAILS=

# 開発用ログイン（POST /api/dev/login）のシークレット。**本番では設定しない**。
# ローカルでは pnpm db:seed:dev が .env.local へ生成する
CI_LOGIN_BYPASS_SECRET=

# Notion買い物リスト連携（#6）。未設定でも補充画面は開き、Notionへ送れないだけになる。
# トークンはNotionのインテグレーション（権限は対象データベースへの「挿入」「更新」だけでよい）
NOTION_API_TOKEN=
# 買い物リストのデータベースid。**実値はコミットしない**（1Password/GitHub Secrets経由で渡す）
NOTION_SHOPPING_DATABASE_ID=
# 送り先データベースのプロパティ名。タイトル以外は未設定なら送らない（既定: 名前）
NOTION_SHOPPING_TITLE_PROPERTY=
NOTION_SHOPPING_QUANTITY_PROPERTY=
NOTION_SHOPPING_SOURCE_PROPERTY=

# アプリの待受ポート。本番は3116（https://stockly.gucchii.com/ からApacheが転送する）
PORT=

# デプロイ時のみ使用（DATABASE_URLの組み立て元）。DB名は app_stockly
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
