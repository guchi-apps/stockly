{
  "name": "stockly",
  "version": "0.3.2",
  "private": true,
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "prisma generate && next build",
    "build:ci": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts'",
    "test:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'db-tests/**/*.test.ts'",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "postinstall": "prisma generate",
    "env:init": "cp -n .env.local.example .env.local && echo '.env.local を編集してください（DATABASE_URL / Supabase）'",
    "db:setup": "bash scripts/setup-db.sh",
    "db:seed:dev": "node scripts/seed-dev.mjs",
    "db:seed": "prisma db seed",
    "db:seed:fixture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/fixtures/daily-inventory.ts",
    "db:rebuild-quantities": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rebuild-lot-quantities.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "job:expiry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/run-expiry-notifications.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "barcode-detector": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
