# ローカル開発用。`pnpm env:init` で .env.local としてコピーしてから編集する。
# .env.local はgit管理外。実シークレットはここと1Passwordにのみ置く。

# ローカルのMariaDB/MySQL。DB名は本番と同じ app_stockly を使う。
# pnpm db:setup がこのURLからDB・ユーザーを作る
DATABASE_URL="mysql://stockly:stockly@127.0.0.1:3306/app_stockly"

# Supabase Auth（他アプリと共有のSupabaseプロジェクト。1Password: apps/Supabase の
# project-url / publishable-key）。Supabaseの Redirect URLs に
# http://localhost:<ポート>/auth/callback を登録しておく
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# 利用を許可するGoogleアカウント（カンマ区切り）。空のままだと誰もログインできない
ALLOWED_GOOGLE_EMAILS=""

# 開発用ログイン（POST /api/dev/login）のシークレット。pnpm db:seed:dev が生成するので
# 手で書かなくてよい。本番には設定しない
# CI_LOGIN_BYPASS_SECRET=""

# 期限の通知の送り先（カンマ区切り）。IN_APP=アプリ内のお知らせ / LOG=サーバーログ。
# 未設定なら IN_APP だけ。メール・LINE等の外部サービスはまだ実装していない
# STOCKLY_NOTIFY_CHANNELS="IN_APP"

# 開発サーバーのポート（省略時は3000）。
# Issueごとのworktreeではセッションが環境変数PORT（28000 + Issue番号。例: Issue #1 なら 28001）を
# 渡してくるため、ここに書かなくてよい。環境変数のほうが優先される（scripts/dev.sh）
# PORT=3000
