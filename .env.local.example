# ローカル開発用。`pnpm env:init` で .env.local としてコピーしてから編集する。
# .env.local はgit管理外。実シークレットはここと1Passwordにのみ置く。

# ローカルのMariaDB/MySQL。DB名は本番と同じ app_stockly を使う
DATABASE_URL="mysql://stockly:stockly@127.0.0.1:3306/app_stockly"

# Supabase Auth（他アプリと共有のSupabaseプロジェクト。1Password: apps/Supabase）。
# ログイン実装Issueまでは空のままでよい
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# 自分のGoogleアカウントのメールアドレス
ALLOWED_GOOGLE_EMAILS=""

# 開発サーバーのポート（省略時は3000）。
# Issueごとのworktreeではセッションが環境変数PORT（28000 + Issue番号。例: Issue #1 なら 28001）を
# 渡してくるため、ここに書かなくてよい。環境変数のほうが優先される（scripts/dev.sh）
# PORT=3000
